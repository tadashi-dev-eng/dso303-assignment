      "data": {
        "serviceId": "lambda",
        "label": "api Lambda (AZ-A)",
        "category": "Compute",
        "health": "healthy",
        "az": "AZ-A",
        "subnet": "private",
        "replicas": 1,
        "multiAz": false,
        "iamRole": {
          "id": "exams-prod-api-role",
          "trustPolicy": {
            "id": "trust",
            "kind": "trust",
            "statements": [
              {
                "effect": "Allow",
                "principals": [
                  "lambda.amazonaws.com",
                  "lambda"
                ],
                "actions": [
                  "sts:AssumeRole"
                ],
                "resources": [
                  "*"
                ]
              }
            ]
          },
          "identityPolicies": [
            {
              "id": "exams-prod-api-policy",
              "kind": "identity",
              "statements": [
                {
                  "effect": "Allow",
                  "actions": [
                    "secretsmanager:GetSecretValue"
                  ],
                  "resources": [
                    "arn:aws:secretsmanager:us-east-1:000000000000:secret:exams-prod/db/master"
                  ]
                },
                {
                  "effect": "Allow",
                  "actions": [
                    "kms:Decrypt",
                    "kms:GenerateDataKey"
                  ],
                  "resources": [
                    "arn:aws:kms:us-east-1:000000000000:key/exams-prod-data"
                  ]
                },
                {
                  "effect": "Allow",
                  "actions": [
                    "dynamodb:PutItem",
                    "dynamodb:UpdateItem",
                    "dynamodb:Query",
                    "dynamodb:GetItem"
                  ],
                  "resources": [
                    "arn:aws:dynamodb:us-east-1:000000000000:table/exams-prod-attempts"
                  ]
                },
                {
                  "effect": "Allow",
                  "actions": [
                    "s3:PutObject"
                  ],
                  "resources": [
                    "arn:aws:s3:::exams-prod-submissions/submissions/*"
                  ]
                },
                {
                  "effect": "Allow",
                  "actions": [
                    "sqs:SendMessage"
                  ],
                  "resources": [
                    "arn:aws:sqs:us-east-1:000000000000:exams-prod-marking",
                    "arn:aws:sqs:us-east-1:000000000000:exams-prod-notify"
                  ]
                }
              ]
            }
          ]
        },
        "notes": "Exam/autosave/upload API. Reserved concurrency 600, provisioned 300 in exam windows."
      }
