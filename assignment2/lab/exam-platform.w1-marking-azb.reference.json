            {
              "id": "exams-prod-notifier-policy",
              "kind": "identity",
              "statements": [
                {
                  "effect": "Allow",
                  "actions": [
                    "secretsmanager:GetSecretValue"
                  ],
                  "resources": [
                    "arn:aws:secretsmanager:us-east-1:000000000000:secret:exams-prod/db/master"
                  ]
                },
                {
                  "effect": "Allow",
                  "actions": [
                    "kms:Decrypt",
                    "kms:GenerateDataKey"
                  ],
                  "resources": [
                    "arn:aws:kms:us-east-1:000000000000:key/exams-prod-data"
                  ]
                },
                {
                  "effect": "Allow",
                  "actions": [
                    "dynamodb:PutItem"
                  ],
                  "resources": [
                    "arn:aws:dynamodb:us-east-1:000000000000:table/exams-prod-submissions"
                  ]
                },
                {
                  "effect": "Allow",
                  "actions": [
                    "s3:GetObject",
                    "s3:GetObjectAttributes"
                  ],
                  "resources": [
                    "arn:aws:s3:::exams-prod-submissions/submissions/*"
                  ]
                },
                {
                  "effect": "Allow",
                  "actions": [
                    "sqs:ReceiveMessage",
                    "sqs:DeleteMessage",
                    "sqs:GetQueueAttributes"
                  ],
                  "resources": [
                    "arn:aws:sqs:us-east-1:000000000000:exams-prod-uploads",
                    "arn:aws:sqs:us-east-1:000000000000:exams-prod-notify"
                  ]
                },
                {
                  "effect": "Allow",
                  "actions": [
                    "ses:SendEmail"
                  ],
                  "resources": [
                    "*"
                  ]
                }
              ]
            }
          ]
        },
        "notes": "Only calls public AWS APIs (S3, DynamoDB, SES, RDS Data API) - no VPC, no NAT dependency."
